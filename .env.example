# Server-only. Never commit real values. Never put these in browser JS.
# CLERK_SECRET_KEY must be an sk_ secret from Clerk Dashboard -> API Keys.
# Do not paste the publishable pk_ key into this slot.
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# PEM public key from Clerk Dashboard -> Configure -> API keys ->
# Show JWT public key -> PEM Public Key. Server-only. Required for
# networkless session verification. Do not fall back to remote JWKS.
CLERK_JWT_KEY=
# GROQ_API_KEY is server-only. Never place it in browser JS, HTML, or client config.
GROQ_API_KEY=

  "compliance_risks": [
    {
      "could_misstate": "Describing any of these as insurance. Describing a discount program as insurance is a material misrepresentation. Six are named as discount programs; the rest are simply unknown, including products whose names sound insured such as AD&D, Critical Care, Term Life and Fusion Dental.",
      "do_not_say": "Do not describe AssistPro, GapSupport, Ameriguard, Prime Health Pass, Express Health Tools or HealthAssist as insurance or as coverage - the portal names each of them a Discount. Do not describe the remaining 36 at all until typed. Do not say 'PPO' about Allstate Dental PPO in a way implying major medical.",
      "fact_class": "verified_plan_fact",
      "risk_id": "K-011",
      "safe_wording": "Nothing product-specific. An add-on should not be described until its type is established.",
      "scope": "PORTFOLIO",
      "severity": "",
      "source": {
        "pg": null,
        "sec": "NEO product list; registry entries with product_type NEEDS_MANUAL_VERIFICATION",
        "src": 68,
        "url": ""
      },
      "verified_fact": "43 add-on products are listed on the NEO platform. NONE has a document in Drive. 36 of them could not be assigned a product type from any available source. Six are typed as discount programs solely because the portal's own product name contains the word 'Discount'.",
      "verify_before_saying": "Before mentioning any add-on by name on a recorded call."
    },
    {
      "could_misstate": "Classifying any product from its name. Doing so produces errors in both directions - calling insurance a membership, and calling a service a discount.",
      "do_not_say": "Never type or describe a product from its name. Read the Info page.",
      "fact_class": "internal_interpretation",
      "risk_id": "K-017",
      "safe_wording": "Nothing client-facing. This is an internal rule.",
      "scope": "PORTFOLIO",
      "severity": "",
      "source": {
        "pg": null,
        "sec": "compared against the 2026-04-08 snapshot",
        "src": 82,
        "url": ""
      },
      "verified_fact": "Product names in this portfolio are unreliable indicators of product type IN BOTH DIRECTIONS. 'AWA SimpleShield Membership Plan' is fixed indemnity insurance. 'Prime Health Pass Discount' is described on its own page as a Diagnostic Services Product delivering services. Between April and September NEO inserted the word 'Membership' into four Safe Guard product names without any evident change of type. Meanwhile 'AssistPro Discount' genuinely is a discount program.",
      "verify_before_saying": "Before any add-on is described on a call, and before any tooling assigns it a category."
    },
    {
      "could_misstate": "",
      "do_not_say": "For any product in this group, do not answer a coverage, exclusion, waiting-period or pre-existing question on a recorded call from portal material alone. Obtain the carrier document first.",
      "fact_class": "internal_interpretation",
      "risk_id": "K-088",
      "safe_wording": "",
      "scope": "PORTFOLIO",
      "severity": "HIGH",
      "source": {
        "pg": null,
        "sec": "",
        "src": null,
        "url": ""
      },
      "verified_fact": "51 of the 80 products on the NEO agent storefront have no brochure, certificate or policy document attached anywhere in the enrolment system. For those products the NEO reference page is the only available source, and four of those pages carry a limitations or exclusions heading with no text beneath it.",
      "verify_before_saying": ""
    },
    {
      "could_misstate": "",
      "do_not_say": "The monthly cost quoted on a recorded call must include this fee, or the fee must be stated separately before the payment authorisation. Quoting the product page price alone understates what the client will be charged.",
      "fact_class": "internal_interpretation",
      "risk_id": "K-096",
      "safe_wording": "",
      "scope": "PORTFOLIO",
      "severity": "HIGH",
      "source": {
        "pg": null,
        "sec": "",
        "src": null,
        "url": "https://www.1enrollment.com/information/product.cfm?page=52630&id=974021"
      },
      "verified_fact": "A 3.5% credit-card or ACH processing fee applies to every payment and appears only in the platform TERMS panel, which more than half the product pages do not display at all.",
      "verify_before_saying": ""
    },
    {
      "could_misstate": "",
      "do_not_say": "Do not tell a client a scheduled benefit amount will be paid in full without qualifying it by the URC limit.",
      "fact_class": "internal_interpretation",
      "risk_id": "K-097",
      "safe_wording": "",
      "scope": "PORTFOLIO",
      "severity": "HIGH",
      "source": {
        "pg": null,
        "sec": "",
        "src": null,
        "url": "https://www.1enrollment.com/information/product.cfm?page=52630&id=974021"
      },
      "verified_fact": "A platform-level usual, reasonable and customary cap applies on top of every product's stated benefits and appears only in the TERMS panel.",
      "verify_before_saying": ""
    },
    {
      "could_misstate": "",
      "do_not_say": "Every recorded verification must cover all four elements. Omitting the recurring monthly amount or the automatic draft is a breach of the platform agreement, not only a compliance risk.",
      "fact_class": "internal_interpretation",
      "risk_id": "K-098",
      "safe_wording": "",
      "scope": "PORTFOLIO",
      "severity": "HIGH",
      "source": {
        "pg": null,
        "sec": "",
        "src": null,
        "url": "https://www.1enrollment.com/information/product.cfm?page=52630&id=974021"
      },
      "verified_fact": "The platform agreement requires an electronic signature or a recorded verification script with every sale, and specifies the four things the member must be shown to understand: the product, its benefits, the initial payment, and the recurring monthly amount drafted automatically.",
      "verify_before_saying": ""
    },
    {
      "could_misstate": "",
      "do_not_say": "Disclose to any client on a tight account that a single failed draft can end the plan.",
      "fact_class": "internal_interpretation",
      "risk_id": "K-099",
      "safe_wording": "",
      "scope": "PORTFOLIO",
      "severity": "HIGH",
      "source": {
        "pg": null,
        "sec": "",
        "src": null,
        "url": "https://www.1enrollment.com/information/product.cfm?page=52630&id=974021"
      },
      "verified_fact": "A dishonoured payment can result in forfeiture of the plan with no liability on anyone's part, expressly including where the dishonour was inadvertent or without cause.",
      "verify_before_saying": ""
    },
    {
      "could_misstate": "",
      "do_not_say": "Never describe NEO as the insurance company. Name the carrier for the specific product.",
      "fact_class": "internal_interpretation",
      "risk_id": "K-100",
      "safe_wording": "",
      "scope": "PORTFOLIO",
      "severity": "MEDIUM",
      "source": {
        "pg": null,
        "sec": "",
        "src": null,
        "url": "https://www.1enrollment.com/information/product.cfm?page=52630&id=974021"
      },
      "verified_fact": "Neo Insurance Solutions is an agency and platform, not the insurer, and disclaims liability for agents' conduct and representations.",
      "verify_before_saying": ""
    },
    {
      "could_misstate": "",
      "do_not_say": "Disclose the 3.5% card/ACH processing fee on every sale regardless of which page the client was shown. Do not rely on the panel a given product page happens to display.",
      "fact_class": "internal_interpretation",
      "risk_id": "K-110",
      "safe_wording": "",
      "scope": "PORTFOLIO",
      "severity": "HIGH",
      "source": {
        "pg": null,
        "sec": "",
        "src": null,
        "url": "https://www.1enrollment.com/information/product.cfm?page=26837&id=974021"
      },
      "verified_fact": "The storefront serves two different versions of the NEO enrolment agreement. The shorter one, on the MDLive pages, omits the 3.5% processing fee, the contact and electronic-document consents, the HIPAA statement and the member signature block.",
      "verify_before_saying": ""
    },
    {
      "could_misstate": "",
      "do_not_say": "Do not tell a client 'the terms are on the page'. Establish which agreement governs their enrolment, and disclose the 3.5% processing fee regardless of which panel their product displays.",
      "fact_class": "internal_interpretation",
      "risk_id": "K-128",
      "safe_wording": "",
      "scope": "PORTFOLIO",
      "severity": "HIGH",
      "source": {
        "pg": null,
        "sec": "",
        "src": null,
        "url": ""
      },
      "verified_fact": "Four different NEO enrolment agreements are in simultaneous circulation on the storefront, and most product pages show none at all.",
      "verify_before_saying": ""
    },
    {
      "could_misstate": "",
      "do_not_say": "Never quote one of these two products from the other's material. Establish which product is being enrolled by its page id, then quote from that product's own brochure. Do not tell a Safe Guard 100 client they have paralysis cover.",
      "fact_class": "internal_interpretation",
      "risk_id": "K-169",
      "safe_wording": "",
      "scope": "PORTFOLIO",
      "severity": "HIGH",
      "source": {
        "pg": null,
        "sec": "",
        "src": null,
        "url": "https://sales.neoinsurancesolutions.com/media/1367/Brochures/AWA_Brochure 100 v3.pdf"
      },
      "verified_fact": "AWA Safe Guard 100 and AWA Safe Guard Accident Membership Plan $100,000 SA have byte-identical NEO pages and the same price, but their carrier brochures carry different benefit schedules - paralysis benefits and a doubled hearing benefit on the SA product only.",
      "verify_before_saying": ""
    }
